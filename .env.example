# Vyomaboard environment configuration (copy to .env to use)

# Authentication mode (global fallback when a school has no config doc)
#   firebase (default) - full email/password + Google sign-in
#   school             - simple name + role + PRN sign-in, no accounts needed.
#                        Schools use this when they don't want per-student
#                        email/password accounts.
VITE_AUTH_MODE=firebase

# Yjs collaboration server URL (defaults to localhost:3002 in dev,
# or same host /yjs in production when unset).
#VITE_YJS_URL=wss://your-backend-host/yjs

# =============================================================================
# PER-SCHOOL AUTH (recommended over the global flag above)
# Create a Firestore doc at:  schools/{schoolId}
# {
#   name: "Example School",
#   auth: {
#     // ORDER matters: the first method is shown as PRIMARY.
#     methods: ["sso", "google", "email", "no-account"],
#     domain: "school.edu",                       // restrict Google to this Workspace domain
#     requiredFields: ["name", "role", "prn"],    // for no-account mode
#     sso: {
#       provider: "saml",                          // "saml" | "oidc" | "oauth"
#       providerId: "saml.example-school"          // must be configured in Firebase Auth console
#     }
#   }
# }
# Supported methods: sso, google, microsoft, email, no-account
# School is auto-detected via subdomain or ?school=<id> on links, or picked
# from the dropdown / code box on the login page.
# =============================================================================